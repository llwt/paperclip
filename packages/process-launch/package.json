{
  "name": "@paperclipai/process-launch",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "executableFiles": [
      "./dist/bin/paperclip-scope-exec"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-helper.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --locked --manifest-path helper/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
